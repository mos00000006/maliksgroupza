{
  "name": "maliks-operations-workers",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.13.0" },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "config": "node scripts/make-config.mjs",
    "migrate:phase4": "wrangler d1 execute maliks-group-hub-db --remote --yes --file sql/phase4_till_shift_register.sql --config .generated/core.json",
    "deploy:core": "wrangler deploy --config .generated/core.json",
    "deploy:pos": "wrangler deploy --config .generated/pos.json",
    "deploy:tills": "wrangler deploy --config .generated/tills.json",
    "deploy:cashoffice": "wrangler deploy --config .generated/cashoffice.json",
    "deploy:dispatch": "wrangler deploy --config .generated/dispatch.json"
  },
  "dependencies": { "jose": "^6.1.0" },
  "devDependencies": { "wrangler": "^4.92.0" }
}
